{
  "name": "celestiea",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx packages/seed/src/cli.ts",
    "migrate": "tsx services/migrator/src/main.ts",
    "explain": "tsx bench/explain.ts",
    "bench": "k6 run bench/catalog.k6.js",
    "docs:api": "tsx scripts/api-docs.ts"
  },
  "devDependencies": {
    "@celestiea/db": "workspace:*",
    "@celestiea/domain": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "~0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
