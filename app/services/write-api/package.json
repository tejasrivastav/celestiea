{
  "name": "@celestiea/write-api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/bundle.mjs dist src/lambda.ts src/authorizer.ts src/local-main.ts",
    "package": "pnpm build && curl -fsSL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o dist/rds-ca.pem && cd dist && rm -f ../write-api.zip && zip -q ../write-api.zip lambda.mjs* authorizer.mjs* rds-ca.pem"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1172.0",
    "@aws-sdk/rds-signer": "^3.1172.0",
    "@celestiea/db": "workspace:*",
    "@celestiea/domain": "workspace:*",
    "fastify": "^5.12.8",
    "iovalkey": "~0.3.3",
    "pg": "^8.23.1",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/pg": "^8.23.1"
  }
}
